{
  "name": "tp-seo-blog",
  "private": true,
  "type": "module",
  "description": "Travelpayouts JP SEO blog monorepo: astro/ (public site), laravel/ (admin + orchestrator), shared content and tooling",
  "workspaces": [
    "astro"
  ],
  "scripts": {
    "dev": "npm run dev -w astro",
    "build": "npm run build -w astro",
    "build:preview": "SITE_URL=https://jp-blog.travelpayouts.com npm run build -w astro",
    "build:prod": "SITE_URL=https://jp-blog.travelpayouts.com INDEXING=true npm run build -w astro",
    "deploy": "sh tools/deploy.sh --yes",
    "deploy:dry": "sh tools/deploy.sh",
    "preview": "npm run preview -w astro",
    "check": "node tools/terms.mjs && node tools/validate.mjs && npm run check -w astro",
    "beautify": "node tools/beautify-html.mjs",
    "slim": "node tools/slim-html.mjs",
    "covers": "node tools/featured-image/convert.mjs --all",
    "agent:update": "gh workflow run update.yml -f dry_run=true",
    "agent:update:live": "gh workflow run update.yml -f dry_run=false",
    "agent:write": "gh workflow run write.yml -f dry_run=true",
    "agent:write:live": "gh workflow run write.yml -f dry_run=false",
    "agent:edit": "gh workflow run edit.yml -f dry_run=true",
    "agent:edit:live": "gh workflow run edit.yml -f dry_run=false",
    "agent:runs": "gh run list --limit 10",
    "terms": "node tools/terms.mjs",
    "terms:fix": "node tools/terms.mjs --fix",
    "agent:plan": "node tools/agent-plan.mjs",
    "agents:on": "gh variable set AGENTS_ENABLED --body true",
    "agents:off": "gh variable set AGENTS_ENABLED --body false",
    "agents:status": "echo \"AGENTS_ENABLED=$(gh variable get AGENTS_ENABLED)\" && node tools/agent-plan.mjs"
  },
  "devDependencies": {
    "js-beautify": "^2.0.3",
    "sharp": "^0.35.5"
  }
}
