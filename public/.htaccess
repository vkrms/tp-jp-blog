# Hostinger / Apache (copied to dist/ on build by Astro's public/ handling).
# Deploy: SSH/SFTP connection "tp-seo-blog", upload dist/ to the subdomain docroot.

AddDefaultCharset utf-8
Options -Indexes
DirectoryIndex index.html

# 404 page (built from src/pages/404.astro)
ErrorDocument 404 /404.html

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Hashed build assets can be cached for a year; HTML must revalidate.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|avif|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
