---
import '../styles/tokens.css';
import '../styles/global.css';
import type { Lang } from '../i18n/ui';
import { path, isIndexedLang } from '../i18n/ui';
interface Props { lang: Lang; title: string; description: string; route: string; ogType?: 'website' | 'article'; noindex?: boolean }
const { lang, title, description, route, ogType = 'website', noindex = false } = Astro.props;
const site = Astro.site!;
const url = (l: Lang) => new URL(path(l, route), site).href;
const indexing = process.env.INDEXING === 'true';
// Google Tag Manager container id. Public by design (it ships in the page HTML), so a default is
// fine; override it with GTM_ID in the build env (.env via deploy.sh, or a CI variable).
const gtmId = (process.env.GTM_ID || '').trim() || 'GTM-T7QG7KB';
// EN is an editorial copy, closed from search (machine translation in the index is a scaled-content risk):
// always noindex, and no hreflang pairs pointing at it (README §9, agents/seo-ja.md §7).
const closed = noindex || !indexing || !isIndexedLang(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gtmId && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(gtmId)});`}></script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    {closed && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url(lang)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    <slot name="head" />
  </head>
  <body>
    {gtmId && (
      <noscript>
        <iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    )}
    <slot />
    <script>
      import '../scripts/analytics';
    </script>
  </body>
</html>
