---
// Dev-only view of the agent schedule (tools/lib/agent-plan.mjs): what writer/updater slots the next weeks have,
// today's slot, and whether the queue actually has anything for the writer to pick up. Never built for production:
// getStaticPaths returns no paths unless `import.meta.env.DEV` (true only under `astro dev`), so `astro build`
// emits nothing here and the route does not exist in dist/. Open it at http://localhost:4321/dev/schedule/ .
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { path: undefined } }] : [];
}

import { execSync } from 'node:child_process';
import { jstInfo, weekPlan, tasksFor } from '../../../../../tools/lib/agent-plan.mjs';
import queueFile from '../../../../../content/queue.json';

const WEEKS = 8;
const { isoYear: todayYear, isoWeek: todayWeek, isoDay: todayDay, date: todayDate } = jstInfo();

// Best-effort live repo variables via `gh` (only meaningful if the developer is logged in; this code never
// ships to prod, so shelling out here is fine). Falls back cleanly when `gh` is missing or unauthenticated.
function ghVar(name: string): string | null {
  try { return execSync(`gh variable get ${name}`, { encoding: 'utf8', timeout: 3000 }).trim(); }
  catch { return null; }
}
const salt = ghVar('AGENT_PLAN_SALT') ?? '';
const enabledRaw = ghVar('AGENTS_ENABLED');
const agentsEnabled = enabledRaw === 'true' ? 'on' : enabledRaw === 'false' ? 'off' : 'unknown (gh not available — run `npm run agents:status`)';

const weeks = Array.from({ length: WEEKS }, (_, i) => {
  const base = jstInfo(new Date(Date.now() + i * 7 * 86400_000));
  const plan = weekPlan(base.isoYear, base.isoWeek, salt);
  const byDay = new Map<number, string[]>();
  for (const s of plan) byDay.set(s.isoDay, [...(byDay.get(s.isoDay) ?? []), s.task]);
  return { isoYear: base.isoYear, isoWeek: base.isoWeek, byDay };
});

const todayTasks = tasksFor(new Date(), salt);

const statusCount = (status: string) => queueFile.queue.filter((q) => q.status === status).length;
const readyTopics = queueFile.queue.filter((q) => ['ready', 'approved'].includes(q.status));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>agent schedule (dev only)</title>
    <style>
      body { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.5; margin: 24px; color: #101828; background: #fafafa; }
      h1 { font-size: 16px; margin: 0 0 4px; }
      .note { color: #667085; margin-bottom: 20px; }
      table { border-collapse: collapse; margin-bottom: 24px; }
      th, td { border: 1px solid #d0d5dd; padding: 6px 10px; text-align: left; vertical-align: top; }
      th { background: #f2f4f7; }
      .today-row { background: #fff7cd; }
      .today-cell { outline: 2px solid #d9480f; outline-offset: -2px; }
      .writer { color: #006dff; font-weight: 600; }
      .updater { color: #0a8f6a; font-weight: 600; }
      .empty { color: #98a2b3; }
      .status { padding: 2px 8px; border-radius: 4px; font-weight: 600; }
      .status.on { background: #d1fae0; color: #0a8f6a; }
      .status.off { background: #fee4e2; color: #b42318; }
      .status.unknown { background: #f2f4f7; color: #667085; }
      .pill { display: inline-block; padding: 1px 7px; border-radius: 999px; background: #eef2ff; margin-right: 6px; font-size: 12px; }
      code { background: #eef0f3; padding: 1px 5px; border-radius: 3px; }
    </style>
  </head>
  <body>
    <h1>agent schedule — dev only</h1>
    <p class="note">Built only under <code>astro dev</code> (not in <code>astro build</code>/dist). Source: tools/lib/agent-plan.mjs.</p>

    <p>
      Today (JST): <b>{todayDate}</b>, W{todayWeek} —
      {todayTasks.length ? todayTasks.map((t) => <span class={t} set:html={`${t} `} />) : <span class="empty">none</span>}
      &nbsp;·&nbsp; Schedule: <span class={`status ${agentsEnabled.startsWith('on') ? 'on' : agentsEnabled.startsWith('off') ? 'off' : 'unknown'}`}>{agentsEnabled}</span>
      &nbsp;·&nbsp; Salt: <code>{salt || '(none)'}</code>
    </p>

    <table>
      <thead>
        <tr><th>Week</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th></tr>
      </thead>
      <tbody>
        {weeks.map(({ isoYear, isoWeek, byDay }) => {
          const isCurrentWeek = isoYear === todayYear && isoWeek === todayWeek;
          return (
            <tr class={isCurrentWeek ? 'today-row' : ''}>
              <td>{isoYear}-W{String(isoWeek).padStart(2, '0')}</td>
              {[1, 2, 3, 4, 5].map((d) => {
                const tasks = byDay.get(d) ?? [];
                const isToday = isCurrentWeek && d === todayDay;
                return (
                  <td class={isToday ? 'today-cell' : ''}>
                    {tasks.length
                      ? tasks.map((t) => <div class={t}>{t}</div>)
                      : <span class="empty">—</span>}
                  </td>
                );
              })}
            </tr>
          );
        })}
      </tbody>
    </table>

    <p>
      Queue: <span class="pill">ready/approved {readyTopics.length}</span>
      <span class="pill">proposed {statusCount('proposed')}</span>
      <span class="pill">idea {statusCount('idea')}</span>
      <span class="pill">held {statusCount('held')}</span>
      <span class="pill">published {statusCount('published')}</span>
    </p>
    {readyTopics.length
      ? <ul>{readyTopics.map((q) => <li><b>{q.keyword}</b> — {q.topic}</li>)}</ul>
      : <p class="note">No ready/approved topics — the next writer slot will skip itself at zero cost (see agents/runtime.md).</p>}

    <p class="note">Reshuffle: <code>gh variable set AGENT_PLAN_SALT --body &lt;anything&gt;</code>. Toggle: <code>npm run agents:on</code> / <code>agents:off</code>.</p>
  </body>
</html>
