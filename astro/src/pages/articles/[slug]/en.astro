---
// /articles/<slug>/en/ — one page per article, English (EN = JA URL + en/, see path() in i18n/ui.ts).
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { articles, type Article } from '../../../data/content';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
---
<ArticleLayout article={article} lang="en" />
