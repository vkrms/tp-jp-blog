---
// "Tabi", the site mascot: a pixel-art portrait of a Japanese traveller.
// Replaces the earlier inline-SVG cloud character. Callers keep sizing it via `.m`
// (see .say .who .m / .prof .m in styles/article.css).
import { Image } from 'astro:assets';
import tabi from '../assets/mascot/tabi.webp';
interface Props { class?: string; label?: string }
const { class: cls, label = 'Tabi' } = Astro.props;
---
<Image
  src={tabi}
  alt=""
  role="img"
  aria-label={label}
  widths={[96, 192]}
  sizes="96px"
  class={['m', cls].filter(Boolean).join(' ')}
/>
<style>
  /* Parent rules set the box size; the square source crops to the circular avatar. */
  .m { display: block; border-radius: 50%; border: 6px solid var(--color-primary-100); height: auto; aspect-ratio: 1; object-fit: cover; }
</style>
